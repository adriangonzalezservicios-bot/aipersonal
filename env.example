# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GEMINI_IMAGE_MODEL: modelo nativo de generación de imágenes (default gemini-3.1-flash-image).
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# GEMINI_MODELS: modelos a probar en orden (separados por coma). Opcional.
# GEMINI_MODELS="gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest"

# RATE_LIMIT_PER_MIN: máximo de solicitudes /api por IP por minuto (default 60).
# RATE_LIMIT_PER_MIN=30

# ANTHROPIC_API_KEY: clave de la API de Anthropic (console.anthropic.com). Activa los motores Claude y el árbitro Claude.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# ARBITER_PROVIDER: "claude" o "gemini". Por defecto claude si hay ANTHROPIC_API_KEY.
# ARBITER_PROVIDER=claude
# ARBITER_MODEL: modelo del árbitro y de las repreguntas (default claude-opus-5-5).
# ARBITER_MODEL=claude-opus-5-5
# CLAUDE_MODEL: modelo por defecto de motores Claude sin modelo explícito.
# CLAUDE_MODEL=claude-sonnet-5-5

# CEREBRO PERSISTENTE (Supabase)
# Crear un proyecto Supabase y ejecutar supabase/migrations/202610020001_brain.sql.
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="TU_SERVICE_ROLE_KEY"
# La clave pública se expone en el bundle del navegador; NUNCA pongas la service role aquí.
VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
VITE_SUPABASE_ANON_KEY="TU_PUBLISHABLE_OR_ANON_KEY"
# El Árbitro usa Gemini para embeddings cuando GEMINI_API_KEY está disponible.
BRAIN_EMBEDDING_MODEL="gemini-embedding-2"
BRAIN_EMBEDDING_DIMENSIONS="768"
BRAIN_MATCH_THRESHOLD="0.52"

# ARBITER_CHALLENGE=false desactiva la auditoría adversarial para ahorrar latencia/costo. Default: true.
ARBITER_CHALLENGE=true
BRAIN_CRITIC_MODEL=claude-sonnet-5-5
